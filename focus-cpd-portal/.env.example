# Focus Vision CPD Portal — environment variables
# (Recreated from README.md — dotfiles were dropped in the Drive upload.)
#
# VITE_* keys are the PUBLIC anon credentials (safe in the browser).
# Everything else is a SECRET used only by the Netlify Function —
# set those in Netlify under Site settings → Environment variables,
# and never prefix them with VITE_.

# Frontend (public)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Netlify Function (secret)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_your_api_key
RESEND_FROM=Focus Vision CPD <cpd@focusvision.com.au>
SITE_URL=https://cpd.focusvision.com.au
