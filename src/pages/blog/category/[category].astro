---
import { getCollection } from "astro:content";
import categoriesData from "../../../data/categories.json";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogPostCard from "../../../components/BlogPostCard.astro";

export async function getStaticPaths() {
	const allPosts = await getCollection("blog");

	// Extract only the categories that are actually used in the posts
	const usedCategoryValues = [
		...new Set(allPosts.map((post) => post.data.category).filter(Boolean)),
	];

	// Filter the master category list to only include used categories
	const activeCategories = categoriesData.items.filter((category) =>
		usedCategoryValues.includes(category.value),
	);

	return activeCategories.map((category) => {
		const filteredPosts = allPosts.filter(
			(post) => post.data.category === category.value,
		);
		const sortedPosts = filteredPosts.sort(
			(a, b) =>
				new Date(b.data.datePublished).valueOf() -
				new Date(a.data.datePublished).valueOf(),
		);

		return {
			params: { category: category.value },
			props: {
				categoryName: category.label,
				posts: sortedPosts,
			},
		};
	});
}

const { categoryName, posts } = Astro.props;

const title = `Posts in Category: ${categoryName} | Focus Vision Blog`;
const description = `Browse all blog posts in the "${categoryName}" category on the Focus Vision blog.`;
const ogType = "website";
---

<BaseLayout description={description} ogType={ogType}>
	<main class="container">
		<h1 class="page-title">Category: {categoryName}</h1>
		{
			posts.length > 0 ? (
				<div class="blog-grid">
					{posts.map((post: any) => (
						<BlogPostCard post={post} />
					))}
				</div>
			) : (
				<p class="no-posts">No posts found in this category yet.</p>
			)
		}
	</main>
</BaseLayout>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 64px 24px;
	}
	.page-title {
		font-size: 3rem;
		font-weight: 700;
		color: #1c2f49;
		text-align: center;
		margin-bottom: 4rem;
	}
	.blog-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 40px;
	}
	.no-posts {
		text-align: center;
		font-size: 1.25rem;
		color: #666;
		margin-top: 2rem;
	}

	@media (max-width: 800px) {
		.blog-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
