	<PhilosophySection />

	<Section backgroundColor="#F4F1ED">
		<h2 class="big-text" style="font-size: 3rem; margin-bottom: 16px;">
			Accreditation and Trust
		</h2>
		<p style="color: #1C2F49; font-size: 1.125rem; margin-bottom: 48px;">
			Meeting and exceeding Australian and International standards.
		</p>
		<AccreditationTable />
	</Section>

	<ConditionsAndProcedures />

	<VisitBanner />

	<div class="center-content-wrap">
		<h2>Meet Our Ophthalmologists</h2>

		<SpiltContent>
			<!-- Column 1 Content -->
			<div>
				<Image src={drGunnImage} alt={`Dr David Gunn`} />
				<h3>Dr David Gunn</h3>
				<p>OPHTHALMOLOGIST</p>
				<Button
					href="/about-dr-david-gunn"
					text="Read More About David"
				/>
			</div>

			<!-- Column 2 Content -->
			<div>
				<Image src={drCroninImage} alt={`Dr Brendan Cronin`} />
				<h3>Dr Brendan Cronin</h3>
				<p>OPHTHALMOLOGIST</p>
				<Button
					href="/about-dr-brendan-cronin"
					text="Read More About Brendan"
				/>
			</div>
		</SpiltContent>
	</div>
	<ImageGallery>
		<Image
			src={galleryImage1}
			alt={`Focus Vision clinic reception area with logo`}
		/>
		<Image
			src={galleryImage2}
			alt={`that Focus Vision clinic entrance and sign`}
		/>
		<Image
			src={galleryImage3}
			alt={`that Patient at the Focus Vision reception desk`}
		/>
		<Image
			src={galleryImage4}
			alt={`that Patient sitting comfortably in the Focus Vision waiting area`}
		/>
		<Image
			src={galleryImage5}
			alt={`that Focus Vision staff member with diagnostic equipment`}
		/>
		<Image
			src={galleryImage6}
			alt={`that Focus Vision clinic consultation room`}
		/>
		<Image
			src={galleryImage7}
			alt={`that Modern and comfortable waiting room at Focus Vision`}
		/>
		<Image
			src={galleryImage8}
			alt={`that Patient receiving an eye scan at Focus Vision`}
		/>
	</ImageGallery>

	<ImageBanner
		backgroundImage={ImageBannerImageOne}
		textAlign="left"
		mobileImagePosition="70% 0%"
	>
		<h2>ARE YOU A CANDIDATE?</h2>
		<p>
			Not quite ready to book an appointment yet? Take the laser
			suitability test and we will send you an information pack customised
			to your vision.
		</p>
		<Button
			href="/laser-suitability-test"
			text="TAKE THE LASER SUITABILITY TEST"
			openInNewTab={false}
		/>
	</ImageBanner>

	<PartnerLogos />
</BaseLayout>
