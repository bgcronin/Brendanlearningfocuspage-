---
//https://www.focusvision.com.au/ray-tracing-lasik
import TreatmentLayout from "../../layouts/TreatmentLayout.astro";
import StyledList from "../../components/StyledList.astro";
import FeatureHeroImage from "../../assets/images/laser-eye-surgeon-focus-vision-brisbane-lasik-laser-eye-surgery-icl-brendan-cronin-david-gunn.jpg";
import placeholder from "../../assets/images/placeholder.png";
import Button from "../../components/Button.astro";
import Card from "../../components/Card.astro";
// Component imports will be added here
import SimpleBanner from "../../components/SimpleBanner.astro";
import CardGrid from "../../components/CardGrid.astro";
import TwoColumnContent from "../../components/TwoColumnContent.astro";
import twoColumnImageDrGunn from "../../assets/images/img-Dr2BGunn2BLaser2BSurgeon2BEye2BBrisbane.webp";
import BottomCTA from "../../components/BottomCTA.astro";
import Faq from "../../components/Faq.astro";
import ReviewedBy from "../../components/ReviewedBy.astro";

const faqs = [
	{
		q: "What is Ray Tracing LASIK?",
		a: "Ray Tracing LASIK is the most personalised form of LASIK available. Instead of planning your treatment from your glasses prescription alone, the system builds a <strong>3D digital model of your individual eye</strong> — including the front and back surfaces of the cornea, the natural lens, and the length of the eye — then traces thousands of simulated light rays through that model to calculate a laser profile unique to your optical system. Focus Vision is the <strong>only clinic in Queensland</strong> offering Ray Tracing LASIK.",
	},
	{
		q: "Is Ray Tracing LASIK the same as WaveLight Plus?",
		a: "Yes. <strong>WaveLight Plus</strong> is the commercial name of the Alcon platform that delivers ray-tracing-guided LASIK (you may also see the name <strong>InnovEyes</strong>, which refers to the 3D eye-modelling technology behind it). If you have been researching 'WaveLight Plus LASIK' or 'InnovEyes' and want the treatment in Queensland, Focus Vision in Brisbane is currently the only clinic where it is available.",
	},
	{
		q: "How is Ray Tracing LASIK different from standard LASIK?",
		a: "Standard LASIK corrects the prescription measured at your glasses test, applied to measurements of the front of your cornea. Ray Tracing LASIK goes further: it measures your <strong>entire optical system</strong> — front and back corneal surfaces, the crystalline lens and the eye's length — and simulates how light actually travels through <em>your</em> eye before a single laser pulse is planned. The result is a fully individualised treatment rather than one based on population averages, giving greater precision and more predictable outcomes.",
	},
	{
		q: "How is ray tracing different from wavefront-guided or topography-guided LASIK?",
		a: "Wavefront-guided LASIK measures how light exits the eye as a whole, and topography-guided LASIK maps the front surface of the cornea — each captures one piece of the puzzle. Ray tracing combines <strong>all of the eye's optical data in a single 3D model</strong> and then simulates vision through the planned correction before treatment. It is the first technology that plans LASIK on a complete, individual model of the eye rather than on one isolated measurement.",
	},
	{
		q: "Will Ray Tracing LASIK give me better night vision?",
		a: "This is one of its key strengths. Halos, starbursts and glare at night are usually caused by <strong>higher-order aberrations</strong> — microscopic optical imperfections that glasses cannot correct. Because ray tracing models and treats your eye's individual aberration profile, most patients experience night vision and contrast after surgery that is as good as or sharper than what they had with glasses or contact lenses.",
	},
	{
		q: "How much does Ray Tracing LASIK cost in Brisbane?",
		a: "At Focus Vision, LASIK costs <strong>$4,250 per eye</strong>, all-inclusive — and ray tracing treatment is <strong>included at no extra charge</strong> for suitable candidates. The price covers all pre-operative assessments, the procedure, and a full year of aftercare appointments, with 24-month interest-free payment plans from around <strong>$41 per week</strong>. See our <a href='/costs'>Costs page</a> for the full breakdown.",
	},
	{
		q: "Am I a suitable candidate for Ray Tracing LASIK?",
		a: "The baseline requirements are the same as for LASIK: over 18, a prescription that has been stable for at least 12 months, healthy corneas of adequate thickness, and no active eye disease. Ray tracing is particularly valuable if you have <strong>astigmatism, larger pupils, a higher prescription, or you drive a lot at night</strong>. If your corneas are too thin for LASIK, TransPRK or ICL surgery may suit you better. Start with our <a href='/laser-suitability-test'>free online suitability test</a> or book a free assessment in Woolloongabba.",
	},
	{
		q: "Is the procedure different on the day compared with normal LASIK?",
		a: "From your point of view, no. The extra work happens before surgery, when the 3D scan of your eye is captured and the individualised profile is calculated. On the day, treatment proceeds exactly like modern LASIK: anaesthetic drops, a femtosecond laser flap, and the excimer laser reshaping — around <strong>10 minutes for both eyes</strong>, with no sharp pain.",
	},
	{
		q: "How long is the recovery after Ray Tracing LASIK?",
		a: "Recovery is the same as standard LASIK. Most patients notice a dramatic improvement within <strong>24 hours</strong> and return to work in one to two days. Your eyes may feel gritty or watery for a few hours after surgery, and temporary dryness in the first weeks is normal and managed with drops.",
	},
	{
		q: "Is Ray Tracing LASIK safe and proven?",
		a: "Yes. Ray-tracing-guided LASIK has been evaluated in peer-reviewed clinical studies, which have consistently reported excellent accuracy and visual outcomes, with a high proportion of eyes achieving 20/20 vision or better. At Focus Vision every procedure is performed by an internationally fellowship-trained corneal subspecialist inside the <strong>South Brisbane Day Hospital</strong> — a fully accredited private day hospital — and our surgeons continuously audit their refractive outcomes.",
	},
	{
		q: "Why is Focus Vision the only clinic in Queensland offering Ray Tracing LASIK?",
		a: "Focus Vision was the <strong>first clinic in Queensland</strong> to invest in the WaveLight Plus ray-tracing platform, and it remains exclusive to our Brisbane laser suite. Our co-founders, <a href='/about-dr-brendan-cronin'>Dr Brendan Cronin</a> and <a href='/about-dr-david-gunn'>Dr David Gunn</a>, are corneal subspecialists with a strong focus on adopting — and independently auditing — genuinely superior technology rather than marketing labels.",
	},
	{
		q: "Can Ray Tracing LASIK correct astigmatism?",
		a: "Yes — astigmatism is where the personalised approach shines. Because the treatment is planned on a 3D model of your actual cornea rather than an averaged shape, ray tracing corrects both regular astigmatism and the subtle irregularities that standard treatments can leave behind. If you have been told your astigmatism makes you a borderline candidate elsewhere, it is worth a <a href='/contact'>free assessment</a> with our team.",
	},
];

const title = "Ray Tracing LASIK Brisbane";
const description = `Focus Vision is the only clinic in Queensland offering Ray Tracing LASIK — laser eye surgery personalised from a 3D model of your eye. Book an assessment today.`;

const author = "Dr Brendan Cronin";
const authorUrl = "/about-dr-brendan-cronin";
const lastReviewed = "2026-05-03T00:00:00Z";

const ogType = "website";
---

<TreatmentLayout
	showCurve={true}
	topColor="#C2DBE3"
	direction="down"
	bottomColor="transparent"
	description={description}
	ogType={ogType}
	author={author}
	authorUrl={authorUrl}
	lastReviewed={lastReviewed}
	title={title}
	pagePath="/vision-correction/ray-tracing-lasik"
	procedureName="Ray Tracing LASIK"
	procedureDescription="An advanced form of laser eye surgery, delivered on the Alcon WaveLight Plus platform, that uses detailed 3D measurements of your unique eye (front and back corneal surfaces and crystalline lens) to personalise the ablation profile for greater precision and more predictable visual outcomes. Focus Vision is the only clinic in Queensland offering Ray Tracing LASIK."
	faqs={faqs}
	backgroundImage={FeatureHeroImage}
	textPosition="left"
	textColor="light"
	heroBottomColor="#FFFFFF"
	addOverlay={true}
>
	<Fragment slot="hero-content">
		<h1>Ray Tracing LASIK</h1>
	</Fragment>

	<SimpleBanner
		textAlign="left"
		backgroundColor="transparent"
		headerColor="#4C8897"
		textColor="#1C2F49"
		textWeight="300"
	>
		<h4>
			Focus Vision stands as the premier and exclusive provider of Ray
			Tracing LASIK in Queensland. This pioneering technology has
			showcased unparalleled visual outcomes compared to other vision
			correction procedures. Utilising cutting-edge laser technology, our
			experts tailor the procedures to individual eye structures,
			guaranteeing a secure and efficient treatment for each patient.
		</h4>
	</SimpleBanner>

	<SimpleBanner
		textAlign="left"
		backgroundColor="#C2DBE3"
		headerColor="#1C2F49"
		textColor="#1C2F49"
		textWeight="300"
	>
		<h3>What is LASIK Ray Tracing?</h3>
		<p>
			Ray tracing is a sophisticated computer-based method used to
			determine the treatment plan for correcting vision issues. This
			technique involves gathering data from a range of the patient's eye
			measurements to create a detailed map of the eye's optical surfaces.
			This includes the front and back surfaces of the cornea and the
			crystalline lens. This technique offers a customisable LASIK
			procedure, resulting in improved and more predictable outcomes.
		</p>

		<h3>How Is It Different from Normal Laser Eye Surgery?</h3>
		<p>
			Traditional laser eye surgery such as LASIK typically follows a
			standard procedure without the details provided by ray tracing.
			While both techniques aim to correct vision problems, ray tracing
			offers a higher level of accuracy and predictability by considering
			the patient's optical characteristics of the eye, resulting in
			improved outcomes for patients undergoing laser eye surgery or lens
			implantation.
		</p>
	</SimpleBanner>

	<SimpleBanner
		textAlign="left"
		backgroundColor="transparent"
		headerColor="#4C8897"
		textColor="#1C2F49"
		textWeight="300"
	>
		<h3>What Are the Benefits of Ray Tracing LASIK surgery?</h3>
		<p>
			<strong>Enhanced precision:</strong> Ray tracing technology enables more
			accurate mapping of the eye, resulting in personalised and precise treatment.
		</p>
		<p>
			<strong>Improved visual outcomes:</strong> The advanced laser technology
			can lead to better visual acuity and reduced risk of complications.
		</p>
		<p>
			<strong>Customised treatments:</strong> By tailoring the procedure to
			individual characteristics, ray tracing offers a higher level of customisation
			and optimisation for each patient's vision correction needs.
		</p>
		<h3>What Happens in The Procedure?</h3>
		<p>
			LASIK ray tracing is a safe and effective method for correcting
			vision and is an innovative option for individuals seeking vision
			correction surgery. Clinical studies and real-world outcomes have
			consistently demonstrated the safety and effectiveness of this
			approach in correcting vision. With its proven track record and
			advancements in precision, LASIK ray tracing represents a trusted
			and reliable option.
		</p>

		<Button href="/contact" text="ScheduLe a Consultation" />
	</SimpleBanner>

	<SimpleBanner
		textAlign="left"
		backgroundColor="#F4F1ED"
		headerColor="#1C2F49"
		textColor="#1C2F49"
		textWeight="300"
	>
		<h3>Am I a Suitable Candidate for Ray Tracing LASIK?</h3>
		<p>
			Suitable candidates for ray tracing-guided laser eye surgery
			typically include individuals who:
		</p>

		<StyledList position="left">
			<li>Have a stable myopic prescription for at least one year.</li>
			<li>Are over the age of 18.</li>
			<li>
				Have healthy eyes with no pre-existing conditions or diseases.
			</li>
			<li>
				Have realistic expectations about the outcomes of the procedure.
			</li>
		</StyledList>

		<p>
			At Focus Vision, we prioritise the wellbeing of our patients by
			conducting thorough eye examinations and consultations with our
			skilled surgeons. These essential steps aim to educate individuals
			about the procedure and determine their suitability as candidates.
			Safety and patient care are paramount values upheld in our clinic,
			ensuring a high-quality experience for all.
		</p>
		<p>
			Focus Vision's exclusive Ray Tracing LASIK procedure, alongside
			personalised treatments and prioritisation of patient safety and
			wellbeing, sets a high standard for vision correction in Queensland.
		</p>
	</SimpleBanner>

	<TwoColumnContent
		imageSrc={twoColumnImageDrGunn}
		imageAlt="Dr. David Gunn operating a machine for premium pterygium surgery in Brisbane with no-stitches approach"
		imagePosition="left"
		backgroundColor="#FFFFFF"
		stylePreset="White"
	>
		<h2>Focus Vision - Experienced Surgeons that you can trust</h2>
		<p>
			Having eye surgery is often a worrying idea to many patients and
			finding the right surgeon and team to trust with your eyesight is
			crucial. At Focus Vision all our consultant anterior segment
			surgeons have undergone extensive training both in Australia and
			internationally so you can trust that your vision is in the most
			experienced hands possible.
		</p>

		<Button
			href="/about-focus-vision"
			text="Read more about the Focus Team"
			openInNewTab={false}
		/>
		<!-- You can add lists, buttons, etc. here -->
	</TwoColumnContent>

	<Faq
		title="Frequently Asked Questions about Ray Tracing LASIK:"
		faqs={faqs}
	/>

	<ReviewedBy
		author={author}
		authorUrl={authorUrl}
		lastReviewed={lastReviewed}
	/>
	<BottomCTA
		h2Text="Ready to enjoy clear vision, clear eyes and improved quality of life?"
		h3Text="Schedule a consultation with our experts today."
		about="Ray Tracing LASIK"
	/>
</TreatmentLayout>
