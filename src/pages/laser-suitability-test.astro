---
//https://www.focusvision.com.au/laser-suitability-test
import BaseLayout from "../layouts/BaseLayout.astro";
const title =
	"Laser Eye Surgery Suitability Test | Focus Vision | Woolloongabba, QLD";
const description = `Find out if you're a candidate with our laser eye surgery suitability test. Get expert advice for a clearer vision. Contact us today to book your assessment.`;
const ogType = "website";
---

<BaseLayout
	showCurve={false}
	topColor="#ffffff"
	direction="down"
	bottomColor="transparent"
	description={description}
	ogType={ogType}
>
	<div class="global-box-content-small">
		<h1>Laser Eye Surgery Suitability Test</h1>
		<p>
			Please complete this form to see if laser eye surgery is a good
			option for you and a member of our friendly team will contact you
			with your results.
		</p>

		<br />

		<iframe
			src="https://api.leadconnectorhq.com/widget/form/euuBgEizZPGNPE3zNqqv"
			style="width:100%;height:100%;border:none;border-radius:3px"
			id="inline-euuBgEizZPGNPE3zNqqv"
			data-layout="{'id':'INLINE'}"
			data-trigger-type="alwaysShow"
			data-trigger-value=""
			data-activation-type="alwaysActivated"
			data-activation-value=""
			data-deactivation-type="neverDeactivate"
			data-deactivation-value=""
			data-form-name="(Website Only) New Focus Vision Form - 06/10"
			data-height="1098"
			data-layout-iframe-id="inline-euuBgEizZPGNPE3zNqqv"
			data-form-id="euuBgEizZPGNPE3zNqqv"
			title="(Website Only) New Focus Vision Form - 06/10"
		>
		</iframe>
		<script src="https://link.msgsndr.com/js/form_embed.js"></script>
	</div>
</BaseLayout>
