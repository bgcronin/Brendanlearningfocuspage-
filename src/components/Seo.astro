---
// src/components/Seo.astro
import siteData from "../data/site.json";
import type { ImageMetadata } from "astro";

export interface Props {
	title: string;
	description: string;
	ogType?: "website" | "article";
	ogImage?: any; // Can be ImageMetadata or GetImageResult
	// Article-specific props
	author?: any; // Can be string (migration) or author object
	datePublished?: Date;
	dateModified?: Date;
	noindex?: boolean;
}

const {
	title, // This prop is the short title, e.g., "Contact Us"
	description,
	ogType = "website",
	ogImage,
	author,
	datePublished,
	dateModified,
	noindex = false,
} = Astro.props;

// --- UPDATED LOGIC ---
// The site name for use in the og:site_name tag.
const siteName = "Focus Vision";
// --------------------

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// If ogImage is already a processed image (from getImage), it has .src and .attributes
// If it's a raw import, it has .src
const ogImageUrl = ogImage?.src
	? new URL(ogImage.src, Astro.site).href
	: new URL("/default-og-image.jpg", Astro.site).href;

const ogWidth = ogImage?.attributes?.width || ogImage?.width;
const ogHeight = ogImage?.attributes?.height || ogImage?.height;
---

<!-- Standard Meta Tags -->
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content={ogType} />
<meta property="og:image" content={ogImageUrl} />
{ogWidth && <meta property="og:image:width" content={ogWidth.toString()} />}
{ogHeight && <meta property="og:image:height" content={ogHeight.toString()} />}

<!-- Article-specific OG tags (Location) -->
{
	ogType === "article" && (
		<>
			<meta property="og:latitude" content={siteData.location.latitude} />
			<meta
				property="og:longitude"
				content={siteData.location.longitude}
			/>
			<meta
				property="og:street-address"
				content={siteData.location.streetAddress}
			/>
			<meta property="og:locality" content={siteData.location.locality} />
			<meta property="og:region" content={siteData.location.region} />
			<meta
				property="og:postal-code"
				content={siteData.location.postalCode}
			/>
			<meta
				property="og:country-name"
				content={siteData.location.countryName}
			/>
		</>
	)
}

<!-- Schema.org (itemprop) tags -->
<meta itemprop="name" content={title} />
<meta itemprop="url" content={canonicalURL} />
<meta itemprop="description" content={description} />
<meta itemprop="image" content={ogImageUrl} />
{
	ogType === "article" && author && (
		<meta
			itemprop="author"
			content={typeof author === "string" ? author : author.name}
		/>
	)
}
{
	ogType === "article" && datePublished && (
		<meta itemprop="datePublished" content={datePublished.toISOString()} />
	)
}
{
	ogType === "article" && dateModified && (
		<meta itemprop="dateModified" content={dateModified.toISOString()} />
	)
}

<!-- Twitter -->
<meta name="twitter:title" content={title} />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
