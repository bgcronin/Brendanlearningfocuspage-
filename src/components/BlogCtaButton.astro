---
// src/components/BlogCtaButton.astro
interface Props {
	href: string;
	label?: string;
	buttonText?: string;
}

const {
	href = "/contact",
	label,
	buttonText = "Book Appointment",
} = Astro.props;

const isExternal = href.startsWith("http");
---

<div class="cta-wrapper">
	<a
		href={href}
		class="blog-cta-btn"
		target={isExternal ? "_blank" : "_self"}
		rel={isExternal ? "noopener noreferrer" : undefined}
	>
		{buttonText}
	</a>
</div>

<style>
	.cta-wrapper {
		margin: 1.5rem 0;
		display: flex;
		justify-content: center;
	}

	.cta-wrapper .blog-cta-btn {
		display: inline-block;
		padding: 14px 32px;
		font-size: 16px;
		font-weight: 500;
		letter-spacing: 0.32px;
		text-transform: uppercase;
		color: #ffffff;
		text-align: center;
		text-decoration: none;
		cursor: pointer;
		border: none;
		border-radius: 50px;
		margin: 10px 0;
		transition:
			background-color 0.2s ease,
			filter 0.2s ease,
			transform 0.2s ease;
		background-color: #437b8c;
		background-image: linear-gradient(
			28deg,
			rgba(67, 123, 140, 1) 18%,
			rgba(36, 81, 104, 1) 55%,
			rgba(29, 54, 80, 1) 100%
		);
	}

	.cta-wrapper .blog-cta-btn:hover {
		background-image: none;
		background-color: #4b8796;
	}
</style>
