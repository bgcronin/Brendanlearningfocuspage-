---
// src/components/Button.astro

// Define the component's props with TypeScript for type safety
interface Props {
	href: string;
	text: string;
	openInNewTab?: boolean; // Optional prop, defaults to false
	variant?: "default" | "white";
}

// Get the props passed to the component
const { href, text, openInNewTab = false, variant = "default" } = Astro.props;
---

<a
	href={href}
	class:list={["custom-button", { "button-white": variant === "white" }]}
	target={openInNewTab ? "_blank" : "_self"}
	rel={openInNewTab ? "noopener noreferrer" : null}
>
	{text}
</a>

<style>
	.custom-button {
		display: inline-block;
		padding: 14px 32px;
		font-size: 16px;
		font-weight: 500;
		letter-spacing: 0.32px;
		text-transform: uppercase;
		color: #ffffff;
		text-align: center;
		text-decoration: none;
		cursor: pointer;
		border: none;
		border-radius: 50px; /* Large value for a pill shape */

		/* Gradient background as requested */
		background: linear-gradient(
			28deg,
			rgba(67, 123, 140, 1) 18%,
			rgba(36, 81, 104, 1) 55%,
			rgba(29, 54, 80, 1) 100%
		);

		/* Ensures the button has a consistent look */
		-webkit-appearance: none;
		-moz-appearance: none;
		appearance: none;
		margin-bottom: 10px;
	}

	.custom-button:hover {
		/* The user-provided hover color */
		background: #4b8796;
	}

	.button-white {
		background: #ffffff;
		color: #1c2f49;
	}

	.button-white:hover {
		background: #f8fafc;
		color: #1c2f49;
	}
</style>
