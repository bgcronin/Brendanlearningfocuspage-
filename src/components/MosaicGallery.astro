---
// src/components/MosaicGallery.astro
// A component for a specific 5-image, 3x2 mosaic layout.
---

<section class="mosaic-gallery-section">
	<div class="gallery-grid">
		<slot />
	</div>
</section>

<style>
	.mosaic-gallery-section {
		padding: 64px 24px;
		background-color: #ffffff;
	}

	.gallery-grid {
		display: grid;
		max-width: 1400px;
		margin: 0 auto;
		/* Define a 3-column, 2-row grid */
		grid-template-columns: repeat(3, 1fr);
		grid-template-rows: repeat(2, 1fr);
		gap: 16px;
	}

	/* --- STYLES FOR SLOTTED IMAGES --- */

	/* 1st image (large one on the left) */
	:global(.gallery-grid > *:nth-child(1)) {
		grid-column: 1 / 2;
		grid-row: 1 / 3;
	}

	/* 2nd image (top middle) */
	:global(.gallery-grid > *:nth-child(2)) {
		grid-column: 2 / 3;
		grid-row: 1 / 2;
	}

	/* 3rd image (top right) */
	:global(.gallery-grid > *:nth-child(3)) {
		grid-column: 3 / 4;
		grid-row: 1 / 2;
	}

	/* 4th image (bottom middle) */
	:global(.gallery-grid > *:nth-child(4)) {
		grid-column: 2 / 3;
		grid-row: 2 / 3;
	}

	/* 5th image (bottom right) */
	:global(.gallery-grid > *:nth-child(5)) {
		grid-column: 3 / 4;
		grid-row: 2 / 3;
	}

	/* Ensure all images fill their grid cell beautifully */
	:global(.gallery-grid img) {
		width: 100%;
		height: 100%;
		object-fit: cover; /* This crops the image to fit, no warping */
		border-radius: 8px;
	}

	/* --- RESPONSIVE STYLES --- */

	/* For mobile, switch to a single column */
	@media (max-width: 800px) {
		.gallery-grid {
			grid-template-columns: 1fr;
			grid-template-rows: auto; /* Let rows size themselves */
		}

		/* On mobile, reset all specific grid placements for a simple vertical stack */
		:global(.gallery-grid > *:nth-child(1)),
		:global(.gallery-grid > *:nth-child(2)),
		:global(.gallery-grid > *:nth-child(3)),
		:global(.gallery-grid > *:nth-child(4)),
		:global(.gallery-grid > *:nth-child(5)) {
			grid-column: auto;
			grid-row: auto;
		}
	}
</style>
