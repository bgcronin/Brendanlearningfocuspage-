---
// src/components/ImageGallery.astro
// This is a simple structural component, so no props are needed.
---

<section class="image-gallery-section">
	<div class="gallery-grid">
		<slot />
	</div>
</section>

<style>
	.image-gallery-section {
		/* Using the background color from the example page */
		background-color: #f4f1ed;
		padding: 134px;
	}

	.gallery-grid {
		display: grid;
		/* Creates the 4x2 grid on desktop */
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
	}

	/* These styles apply to the <img> tags you place inside the component */
	:global(.gallery-grid img) {
		width: 100%;
		height: 100%;
		/* This ensures images fill the grid cell without being stretched or warped */
		object-fit: cover;
	}

	/* Tablet responsive styles */
	@media (max-width: 1200px) {
		.image-gallery-section {
			padding: 48px 60px;
		}
		.gallery-grid {
			/* Switch to 2 columns on tablets */
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* Mobile responsive styles */
	@media (max-width: 800px) {
		.image-gallery-section {
			padding: 40px 24px;
		}
		.gallery-grid {
			/* Switch to a single column on mobile */
			grid-template-columns: 1fr;
		}
	}
</style>
