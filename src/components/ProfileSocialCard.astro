---
interface Props {
	websiteUrl: string;
	linkedinUrl: string;
}

const { websiteUrl, linkedinUrl } = Astro.props;
---

<div class="profile-social-card">
	<a
		href={websiteUrl}
		target="_blank"
		rel="noopener noreferrer"
		class="social-link"
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 448 512"
			class="icon"
		>
			<!-- Font Awesome Free 6.7.2 - up-right-from-square -->
			<path
				fill="currentColor"
				d="M384 32c35.3 0 64 28.7 64 64l0 320c0 35.3-28.7 64-64 64L64 480c-35.3 0-64-28.7-64-64L0 96C0 60.7 28.7 32 64 32l320 0zM160 144c-13.3 0-24 10.7-24 24s10.7 24 24 24l94.1 0L135 311c-9.4 9.4-9.4 24.6 0 33.9s24.6 9.4 33.9 0L288 225.9 288 320c0 13.3 10.7 24 24 24s24-10.7 24-24l0-176c0-13.3-10.7-24-24-24L160 144z"
			></path>
		</svg>
		<span>Website</span>
	</a>
	<a
		href={linkedinUrl}
		target="_blank"
		rel="noopener noreferrer"
		class="social-link"
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 448 512"
			class="icon"
		>
			<path
				fill="currentColor"
				d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z"
			></path>
		</svg>
		<span>LinkedIn</span>
	</a>
</div>

<style>
	.profile-social-card {
		display: flex;
		gap: 20px;
		margin-top: 15px;
		justify-content: flex-start;
		align-items: center;
	}

	.social-link {
		display: flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
		color: #1c2f49;
		font-weight: 500;
		font-size: 0.95rem;
		transition: color 0.3s ease;
	}

	.social-link:hover {
		color: #4b8796;
	}

	.icon {
		width: 18px;
		height: 18px;
		color: #4b8796;
	}
</style>
