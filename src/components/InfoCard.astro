---
// src/components/InfoCard.astro
interface Props {
	title: string;
	iconBgColor?: string;
}

const { title, iconBgColor = "#2563EB" } = Astro.props;
---

<article class="info-card">
	<div class="icon-box" style={`background-color: ${iconBgColor};`}>
		<slot name="icon" />
	</div>
	<div class="content">
		<h3>{title}</h3>
		<slot />
	</div>
</article>

<style>
	.info-card {
		background-color: #ffffff;
		border: 1px solid #e5e7eb;
		border-radius: 24px;
		padding: 40px;
		display: flex;
		flex-direction: column;
		height: 100%;
		text-align: left;
		transition:
			transform 0.2s ease-in-out,
			box-shadow 0.2s ease-in-out;
	}

	.info-card:hover {
		transform: translateY(-4px);
		box-shadow:
			0 10px 25px -5px rgba(0, 0, 0, 0.1),
			0 8px 10px -6px rgba(0, 0, 0, 0.1);
	}

	.icon-box {
		width: 48px;
		height: 48px;
		border-radius: 10px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 24px;
		color: #ffffff;
		box-shadow:
			0 4px 6px -1px rgba(0, 0, 0, 0.1),
			0 2px 4px -2px rgba(0, 0, 0, 0.1);
	}

	.icon-box :global(svg) {
		width: 24px;
		height: 24px;
	}

	.content h3 {
		font-size: 1.5rem;
		font-weight: 700;
		color: #1c2f49;
		margin: 0 0 16px 0;
		line-height: 1.2;
	}

	.content :global(p) {
		font-size: 16px;
		line-height: 1.6;
		color: #4b5563;
		margin: 0 0 16px 0;
	}

	.content :global(p:last-child) {
		margin-bottom: 0;
	}

	.content :global(ul) {
		list-style: none;
		padding: 0;
		margin: 16px 0 0 0;
	}

	.content :global(li) {
		display: flex;
		align-items: flex-start;
		gap: 8px;
		margin-bottom: 12px;
		font-size: 15px;
		color: #4b5563;
	}

	.content :global(li svg) {
		flex-shrink: 0;
		width: 16px;
		height: 16px;
		margin-top: 4px;
		color: #2563eb;
	}
</style>
